# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin
# Wrap bcrypt hash in escaped dollars — Next.js expands $VAR in .env otherwise
# Example: ADMIN_PASSWORD_HASH=\$2b\$12\$YourHashHere...
ADMIN_PASSWORD_HASH=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment (Khalti — also supports eSewa & cards at checkout)
KHALTI_SECRET_KEY=
NEXT_PUBLIC_KHALTI_PUBLIC_KEY=
KHALTI_SANDBOX=true
NEXT_PUBLIC_SITE_URL=https://www.newvisionfoundation.org.np
NEXT_PUBLIC_BANK_QR_IMAGE=/ngo/payment/bank-qr.svg
NEXT_PUBLIC_BANK_NAME=Nepal Bank Ltd.
NEXT_PUBLIC_BANK_ACCOUNT=0123456789012345

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
